{
  "name": "toi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:messages": "tsx scripts/check-messages.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "sms:test": "tsx scripts/sms-test.ts",
    "start:standalone": "node scripts/start-standalone.mjs",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:local": "tsx scripts/db-local.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-empty": "tsx scripts/seed-empty.ts",
    "admin:owner-link": "tsx scripts/admin-owner-link.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.5.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@next/env": "16.4.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
